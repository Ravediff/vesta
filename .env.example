# Copy this file to .env and fill it in. Never commit .env or share the token.

# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
TOKEN=

# Optional: default welcome/goodbye channels (right-click channel → Copy Channel ID).
# /config welcome and /config goodbye override these per server.
WELCOME_CHANNEL_ID=
LEAVE_CHANNEL_ID=

# Optional: only needed if Vesta is in several servers and you have an old xp.json to import.
GUILD_ID=

# Optional: where data is stored (default: ./data)
DATA_DIR=
